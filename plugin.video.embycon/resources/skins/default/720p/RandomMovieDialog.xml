<?xml version="1.0" encoding="UTF-8"?>
<!-- v1.15 : dialogue « Film au hasard »
     v1.18.3 : Precedent / Lire / Suivant / Annuler
     v1.18.2 : plein ecran, fanart du film en fond (on ne voit plus la liste
     de l'extension derriere), voile sombre pour la lisibilite -->
<window id="3302" type="dialog">
	<defaultcontrol always="true">4020</defaultcontrol>
	<zorder>2</zorder>
	<coordinates>
		<system>1</system>
		<left>0</left>
		<top>0</top>
	</coordinates>
	<animation effect="fade" time="250">WindowOpen</animation>
	<animation effect="fade" time="200">WindowClose</animation>
	<controls>

		<!-- fond opaque : masque l'explorateur de l'extension -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1280</width>
			<height>720</height>
			<texture colordiffuse="FF000000">white.png</texture>
		</control>

		<!-- fanart du film -->
		<control type="image" id="4016">
			<left>0</left>
			<top>0</top>
			<width>1280</width>
			<height>720</height>
			<aspectratio>scale</aspectratio>
			<fadetime>300</fadetime>
			<texture></texture>
		</control>

		<!-- voile sombre pour la lisibilite -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1280</width>
			<height>720</height>
			<texture colordiffuse="99000000">white.png</texture>
		</control>

		<control type="group">
		<left>190</left>
		<top>150</top>

		<!-- fond -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>900</width>
			<height>400</height>
			<texture border="40">bg.png</texture>
		</control>

		<!-- en-tete -->
		<control type="label" id="4011">
			<left>30</left>
			<top>12</top>
			<width>600</width>
			<height>30</height>
			<font>font12</font>
			<textcolor>FFAAAAAA</textcolor>
			<align>left</align>
			<label></label>
		</control>

		<!-- affiche -->
		<control type="image" id="4015">
			<left>30</left>
			<top>50</top>
			<width>200</width>
			<height>300</height>
			<aspectratio>keep</aspectratio>
			<fadetime>300</fadetime>
			<texture></texture>
		</control>

		<!-- titre -->
		<control type="label" id="4012">
			<left>260</left>
			<top>48</top>
			<width>610</width>
			<height>40</height>
			<font>font14</font>
			<align>left</align>
			<scroll>true</scroll>
			<label></label>
		</control>

		<!-- annee · duree · genres · note -->
		<control type="label" id="4013">
			<left>260</left>
			<top>90</top>
			<width>610</width>
			<height>30</height>
			<font>font12</font>
			<textcolor>FFAAAAAA</textcolor>
			<align>left</align>
			<label></label>
		</control>

		<!-- resume -->
		<control type="textbox" id="4014">
			<left>260</left>
			<top>128</top>
			<width>610</width>
			<height>180</height>
			<font>font12</font>
			<align>left</align>
			<autoscroll delay="4000" time="2000" repeat="6000"></autoscroll>
			<label></label>
		</control>

		<!-- Precedent (desactive au premier tirage) -->
		<control type="button" id="4023">
			<left>260</left>
			<top>328</top>
			<width>140</width>
			<height>50</height>
			<texturenofocus border="1" colordiffuse="ff161616">white.png</texturenofocus>
			<texturefocus border="1" colordiffuse="ff525252">white.png</texturefocus>
			<font>font13</font>
			<align>center</align>
			<aligny>center</aligny>
			<disabledcolor>44FFFFFF</disabledcolor>
			<onleft>4022</onleft>
			<onright>4020</onright>
			<label></label>
		</control>

		<!-- Lire -->
		<control type="button" id="4020">
			<left>416</left>
			<top>328</top>
			<width>140</width>
			<height>50</height>
			<texturenofocus border="1" colordiffuse="ff161616">white.png</texturenofocus>
			<texturefocus border="1" colordiffuse="ff525252">white.png</texturefocus>
			<font>font13</font>
			<align>center</align>
			<aligny>center</aligny>
			<onleft>4023</onleft>
			<onright>4021</onright>
			<label></label>
		</control>

		<!-- Suivant (nouveau tirage ou tirage deja vu) -->
		<control type="button" id="4021">
			<left>572</left>
			<top>328</top>
			<width>140</width>
			<height>50</height>
			<texturenofocus border="1" colordiffuse="ff161616">white.png</texturenofocus>
			<texturefocus border="1" colordiffuse="ff525252">white.png</texturefocus>
			<font>font13</font>
			<align>center</align>
			<aligny>center</aligny>
			<onleft>4020</onleft>
			<onright>4022</onright>
			<label></label>
		</control>

		<!-- Annuler -->
		<control type="button" id="4022">
			<left>728</left>
			<top>328</top>
			<width>140</width>
			<height>50</height>
			<texturenofocus border="1" colordiffuse="ff161616">white.png</texturenofocus>
			<texturefocus border="1" colordiffuse="ff525252">white.png</texturefocus>
			<font>font13</font>
			<align>center</align>
			<aligny>center</aligny>
			<onleft>4021</onleft>
			<onright>4020</onright>
			<label></label>
		</control>

		</control>

	</controls>
</window>
